+"""
+Tests for migration_0001_room_home: explicit data fixtures, migration execution, validation, idempotency, flag toggle compatibility, partial failures, and documentation for human safety/recovery.
+"""
+
+import copy
+import pytest
+
+from migrations import migration_0001_room_home as mig
+
+
+@pytest.fixture
+def legacy_project_dict():
+    # Pre-migration legacy fixture: minimal but realistic
+    return {
+        "context_key": "proj-legacy-x",
+        "brief": {"lifestyle": "", "keep": [], "avoid": [], "style_preferences": ""},
+        "rooms": {
+            "living": {
+                "name": "Living Room",
+                "room_type": "living",
+                "width_ft": 10.0,
+                "existing_pieces": ["Couch"],
+                # No home_id
+            }
+        },
+        "spec_list": [],
+        "cart": [],
+        "skipped": [],
+        "board_pins": [],
+        "rejected": [],
+        "budget_total_cents": 20000,
+        "pending_approval": False,
+        "approvals": {"concept": False, "budget": False, "spec": False},
+        "status": "intake",
+        # no homes here, pre-migration
+    }
+
+
+def test_migration_adds_home_id_and_homes(legacy_project_dict):
+    project = copy.deepcopy(legacy_project_dict)
+    migrated = mig.migrate(project)
+    assert "homes" in migrated
+    home_ids = list(migrated["homes"].keys())
+    assert home_ids, "Default home must be present"
+    new_room = migrated["rooms"]["living"]
+    assert "home_id" in new_room
+    assert new_room["home_id"] == home_ids[0]
+
+
+def test_idempotency_on_repeat_runs(legacy_project_dict):
+    # Run migrate twice, result same as one run
+    first = mig.migrate(copy.deepcopy(legacy_project_dict))
+    repeated = mig.migrate(copy.deepcopy(first))
+    assert first == repeated
+
+
+def test_existing_home_id_not_overwritten(legacy_project_dict):
+    project = copy.deepcopy(legacy_project_dict)
+    # Add a home_id by hand (simulate partial old migration)
