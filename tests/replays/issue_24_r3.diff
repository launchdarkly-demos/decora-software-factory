new file mode 100644
index 0000000..7535f06
--- /dev/null
+++ b/app/home.py
@@ -0,0 +1,76 @@
+from __future__ import annotations
+import uuid
+from pydantic import BaseModel, Field
+
+
+class Home(BaseModel):
+    id: str = Field(default_factory=lambda: str(uuid.uuid4()))
+    name: str
+    address: str = ""
+    notes: str = ""
+
+    def model_dump_public(self) -> dict:
+        return {
+            "id": self.id,
+            "name": self.name,
+            "address": self.address,
+            "notes": self.notes,
+        }
+
+
+# Home registry implementation
+from typing import Optional, Dict
+from threading import Lock
+
+# _homes is a process-local registry by ID
+_homes: Dict[str, Home] = {}
+_homes_lock = Lock()
+# The default home name/ID
+DEFAULT_HOME_NAME = "Default Home"
+DEFAULT_HOME_ID = None
+
+
+def get_default_home() -> Home:
+    """Return the default home, always present in registry."""
+    global DEFAULT_HOME_ID
+    with _homes_lock:
+        # Look up by name, or create if not present
+        for home in _homes.values():
+            if home.name == DEFAULT_HOME_NAME:
+                DEFAULT_HOME_ID = home.id
+                return home
+        # Not found, make it
+        home = Home(name=DEFAULT_HOME_NAME)
+        DEFAULT_HOME_ID = home.id
+        _homes[home.id] = home
+        return home
+
+
+def get_home_by_id(home_id: str) -> Optional[Home]:
+    """Fetch a home by its ID, or None if not found."""
+    with _homes_lock:
+        return _homes.get(home_id)
+
+
+def all_homes() -> list[Home]:
+    """List all homes in the registry."""
+    with _homes_lock:
+        return list(_homes.values())
+
+
+def upsert_home(home: Home) -> None:
+    """Add or update a home by ID."""
+    with _homes_lock:
+        _homes[home.id] = home
+
+
+def clear_homes() -> None:
+    """Clear the registry (testing)."""
+    global DEFAULT_HOME_ID
+    with _homes_lock:
+        _homes.clear()
+        DEFAULT_HOME_ID = None
+
+
+# Register the default home at module load
+get_default_home()
