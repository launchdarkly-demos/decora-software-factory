diff --git a/migrations/migration_0001_room_home.py b/migrations/migration_0001_room_home.py
new file mode 100644
index 0000000..904224c
--- /dev/null
+++ b/migrations/migration_0001_room_home.py
@@ -0,0 +1,58 @@
+"""
+Migration 0001: Assign all legacy rooms (rooms with no home_id) to the default home.
+
+Idempotency: This script can be safely run multiple times; only rooms that lack a home_id
+are affected and no data is ever overwritten or moved if the data already conforms.
+
+Preserves all existing room data, links, and Home/room associations as-is except for assigning
+the default home_id to rooms without one. Project dict structure and keys are otherwise untouched.
+
+Failure/Recovery: If this migration fails partway, rerunning is safe. If error is encountered
+(e.g., corrupt rooms, missing dicts), the script will not reassign or override existing home_id.
+To repair, fix data/corruption and rerun.
+
+Timing: This migration should be run after the new Home registry (home.py) and room model changes
+are deployed, but before any features allow multi-home projects. Running after the flag is enabled
+is safe and will not change already-migrated rooms.
+"""
+
+from app.home import get_default_home
+
+
+def migrate(project_dict):
+    rooms = project_dict.get("rooms")
+    if not isinstance(rooms, dict):
+        return project_dict  # No-op if structure missing
+    # Ensure 'homes' dict present
+    homes = project_dict.get("homes")
+    default_home = get_default_home()
+    home_id = default_home.id
+    if homes is None or not isinstance(homes, dict):
+        homes = {home_id: default_home.model_dump_public()}
+        project_dict["homes"] = homes
+    else:
+        # Only add if not present
+        if home_id not in homes:
+            homes[home_id] = default_home.model_dump_public()
+    # Assign all rooms missing home_id
+    for room in rooms.values():
+        # Only add if not present (idempotent)
+        if "home_id" not in room or not room["home_id"]:
+            room["home_id"] = home_id
+    return project_dict
+
+
+def rollback(project_dict):
+    """Removes all 'home_id' fields and the 'homes' dict for downgrade."""
+    rooms = project_dict.get("rooms")
+    if isinstance(rooms, dict):
+        for room in rooms.values():
+            room.pop("home_id", None)
+    if "homes" in project_dict:
+        project_dict.pop("homes", None)
+    return project_dict
+
+
+# End of migration script.
+# To recover from a mid-migration or failed run: fix project data to valid state and rerun migrate().
+# No context/project key is remapped, only missing room["home_id"] is set.
